rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function workspaceMember(workspaceId) {
      return signedIn()
        && exists(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid));
    }

    function memberRole(workspaceId) {
      return get(/databases/$(database)/documents/workspaces/$(workspaceId)/members/$(request.auth.uid)).data.role;
    }

    function workspaceOwner(workspaceId) {
      return workspaceMember(workspaceId) && memberRole(workspaceId) == 'owner';
    }

    function canWriteWorkspace(workspaceId) {
      return workspaceMember(workspaceId) && memberRole(workspaceId) in ['owner', 'member'];
    }

    function canReadRecord(workspaceId) {
      return workspaceMember(workspaceId)
        && (resource.data.visibility == 'shared' || resource.data.owner_user_id == request.auth.uid);
    }

    function canCreateRecord(workspaceId) {
      return canWriteWorkspace(workspaceId)
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.workspace_id == workspaceId
        && (!('visibility' in request.resource.data) || request.resource.data.visibility in ['private', 'shared']);
    }

    function canUpdateRecord(workspaceId) {
      return canWriteWorkspace(workspaceId)
        && canReadRecord(workspaceId)
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.workspace_id == resource.data.workspace_id
        && (!('visibility' in request.resource.data) || request.resource.data.visibility in ['private', 'shared']);
    }

    match /users/{userId} {
      allow get: if signedIn() && request.auth.uid == userId;
      allow list: if false;
      allow create: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == request.auth.uid;
      allow update: if signedIn()
        && request.auth.uid == userId
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'photoURL', 'email', 'workspaceId', 'updatedAt']);
      allow delete: if false;
    }

    match /workspaces/{workspaceId} {
      allow create: if signedIn()
        && workspaceId == request.auth.uid
        && request.resource.data.owner_user_id == request.auth.uid
        && request.resource.data.type in ['personal', 'household'];
      allow get: if signedIn() && (workspaceId == request.auth.uid || workspaceMember(workspaceId));
      allow list: if false;
      allow update: if workspaceOwner(workspaceId)
        && request.resource.data.owner_user_id == resource.data.owner_user_id
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if false;

      match /members/{memberId} {
        allow get: if signedIn() && (request.auth.uid == memberId || workspaceOwner(workspaceId));
        allow list: if workspaceOwner(workspaceId);
        allow create: if signedIn()
          && request.resource.data.uid == memberId
          && request.resource.data.role in ['owner', 'member', 'auditor']
          && (
            (memberId == request.auth.uid
              && workspaceId == request.auth.uid
              && getAfter(/databases/$(database)/documents/workspaces/$(workspaceId)).data.owner_user_id == request.auth.uid
              && request.resource.data.role == 'owner')
            || workspaceOwner(workspaceId)
          );
        allow update: if workspaceOwner(workspaceId)
          && request.resource.data.uid == resource.data.uid
          && request.resource.data.role in ['member', 'auditor'];
        allow delete: if workspaceOwner(workspaceId) && memberId != request.auth.uid;
      }

      match /accounts/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId);
        allow update: if canUpdateRecord(workspaceId);
        allow delete: if canWriteWorkspace(workspaceId) && canReadRecord(workspaceId);
      }

      match /transactions/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId)
          && request.resource.data.amount_minor is int
          && request.resource.data.amount_minor > 0;
        allow update, delete: if false;
      }

      match /debts/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId);
        allow update: if canUpdateRecord(workspaceId);
        allow delete: if canWriteWorkspace(workspaceId) && canReadRecord(workspaceId);
      }

      match /budgets/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId);
        allow update: if canUpdateRecord(workspaceId);
        allow delete: if canWriteWorkspace(workspaceId) && canReadRecord(workspaceId);
      }

      match /savings_goals/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId);
        allow update: if canUpdateRecord(workspaceId);
        allow delete: if canWriteWorkspace(workspaceId) && canReadRecord(workspaceId);
      }

      match /commitments/{recordId} {
        allow get, list: if canReadRecord(workspaceId);
        allow create: if canCreateRecord(workspaceId);
        allow update: if canUpdateRecord(workspaceId);
        allow delete: if canWriteWorkspace(workspaceId) && canReadRecord(workspaceId);
      }
    }

    match /categories/{categoryId} {
      allow get, list: if signedIn();
      allow create, update, delete: if false;
    }

    // Legacy root financial paths and unknown collections remain denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
