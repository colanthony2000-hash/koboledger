rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny catch-all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Users Collection
    match /users/{userId} {
      allow get: if isSignedIn() && (isOwner(userId) || resource.data.workspaceId == request.auth.token.workspaceId);
      allow list: if isSignedIn();
      allow create: if isOwner(userId) && incoming().uid == request.auth.uid && incoming().email is string;
      allow update: if isOwner(userId) && incoming().uid == existing().uid && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'workspaceId']);
      allow delete: if false;
    }

    // Accounts Collection
    match /accounts/{accountId} {
      allow get: if isSignedIn() && isValidId(accountId) && (resource.data.visibility == 'shared' || resource.data.owner_user_id == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(accountId) && incoming().owner_user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(accountId) && (existing().owner_user_id == request.auth.uid || existing().visibility == 'shared');
      allow delete: if isSignedIn() && isValidId(accountId) && existing().owner_user_id == request.auth.uid;
    }

    // Transactions Collection
    match /transactions/{transactionId} {
      allow get: if isSignedIn() && isValidId(transactionId) && (resource.data.visibility == 'shared' || resource.data.owner_user_id == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(transactionId) && incoming().owner_user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(transactionId) && (existing().owner_user_id == request.auth.uid || existing().visibility == 'shared');
      allow delete: if false; // Invariant: Transactions are immutable; reversals only
    }

    // Categories Collection
    match /categories/{categoryId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(categoryId);
      allow delete: if false;
    }

    // Debts Collection
    match /debts/{debtId} {
      allow get: if isSignedIn() && isValidId(debtId) && (resource.data.visibility == 'shared' || resource.data.owner_user_id == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(debtId) && incoming().owner_user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(debtId) && (existing().owner_user_id == request.auth.uid || existing().visibility == 'shared');
      allow delete: if isSignedIn() && isValidId(debtId) && existing().owner_user_id == request.auth.uid;
    }

    // Budgets Collection
    match /budgets/{budgetId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(budgetId);
      allow delete: if isSignedIn() && isValidId(budgetId);
    }

    // Savings Goals Collection
    match /savings_goals/{goalId} {
      allow get, list: if isSignedIn();
      allow create, update: if isSignedIn() && isValidId(goalId);
      allow delete: if isSignedIn() && isValidId(goalId);
    }

    // Commitments Collection
    match /commitments/{commitmentId} {
      allow get, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(commitmentId) && incoming().owner_user_id == request.auth.uid;
      allow update: if isSignedIn() && isValidId(commitmentId);
      allow delete: if isSignedIn() && isValidId(commitmentId) && existing().owner_user_id == request.auth.uid;
    }
  }
}
